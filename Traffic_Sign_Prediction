(dropout_rate))\n","  cnn.add(layers.Dense(num_classes, activation='softmax'))\n","\n","  cnn.compile(optimizer='adam',\n","              loss='sparse_categorical_crossentropy',\n","              metrics=['accuracy'])\n","\n","  return cnn"],"metadata":{"id":"ZjKWqyNW9V_c","executionInfo":{"status":"ok","timestamp":1758993971200,"user_tz":-420,"elapsed":8,"user":{"displayName":"Kira Nguyen","userId":"12077576976160969071"}}},"execution_count":12,"outputs":[]},{"cell_type":"markdown","source":["## 7. Train a set of models"],"metadata":{"id":"y7YEw4Hxgu2J"}},{"cell_type":"code","source":["\n","#override the conv_blocks argument in the base builder function\n","models_to_try = {\n","    \"CNN_3x3\": build_cnn_with_filter(conv_blocks=[(32, (3,3))]),\n","    \"CNN_5x5\": build_cnn_with_filter(conv_blocks=[(32, (5,5))]),\n","    \"CNN_9x9\": build_cnn_with_filter(conv_blocks=[(32, (9,9))]),\n","}\n","\n","history_full = {}\n","for name, model in models_to_try.items():\n","  print(f\"Training {name}\")\n","\n","  history = model.fit(data['x_train'], data['y_train'], epochs=5, batch_size=100,\n","                      validation_data=(data['x_validation'], data['y_validation']),\n","                      verbose=1)\n","\n","  history_full[name] = history\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"E6PqF3amlusg","executionInfo":{"status":"ok","timestamp":1758997241664,"user_tz":-420,"elapsed":3218858,"user":{"displayName":"Kira Nguyen","userId":"12077576976160969071"}},"outputId":"08b65d43-4203-4703-d99f-4760d68d5d9b"},"execution_count":13,"outputs":[{"output_type":"stream","name":"stdout","text":["Training CNN_3x3\n","Epoch 1/5\n","\u001b[1m870/870\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m137s\u001b[0m 156ms/step - accuracy: 0.5547 - loss: 1.6772 - val_accuracy: 0.8705 - val_loss: 0.4608\n","Epoch 2/5\n","\u001b[1m870/870\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m145s\u001b[0m 15