st:8080/"},"id":"LAyi8q7xZIL0","executionInfo":{"status":"ok","timestamp":1758993777569,"user_tz":-420,"elapsed":192,"user":{"displayName":"Kira Nguyen","userId":"12077576976160969071"}},"outputId":"e66fa0f2-007b-4a04-84f8-32bcbbb2825b"},"execution_count":6,"outputs":[{"output_type":"stream","name":"stdout","text":["dtype: float32\n","min: -0.37349513\n","max: 0.8779018\n"]}]},{"cell_type":"markdown","source":["## 2. Preview some instances"],"metadata":{"id":"f-VBYfU4xBXz"}},{"cell_type":"code","source":["def convert_to_grid(x_input, max_images=100):\n","  \"\"\"\n","  Convert a list of images into a grid of images.\n","\n","  x_input: numpy arrray of shape (N, H, W, C)\n","  max_images: number of images to convert to grid\n","  \"\"\"\n","  N, H, W, C = x_input.shape\n","  N = min(N, max_images) # safety limit in case of a large N\n","  grid_size = int(np.ceil(np.sqrt(N))) #no. of row equals no. of columns\n","\n","  #white background\n","  grid_height = H * grid_size + 1 * (grid_size - 1)\n","  grid_width = W * grid_size + 1 * (grid_size - 1)\n","  grid = np.ones((grid_height, grid_width, C), dtype=np.float32) * 255\n","\n","  next_idx = 0 #keep track of which image we're pasting\n","\n","  for row in range(grid_size):\n","    for col in range(grid_size):\n","      if next_idx >= N: #stop if we placed all images\n","        break\n","\n","      #compute placement coordinates\n","      y0 = row * (H + 1)\n","      y1 = y0 + H\n","      x0 = col * (W + 1)\n","      x1 = x0 + W\n","\n","      #normalize to [0, 255]\n","      img = x_input[next_idx]\n","      img = (img - img.min()) / (img.max() - img.min()) * 255\n","\n","      #paste image\n","      grid[y0:y1, x0:x1, :] = img\n","\n","      next_idx += 1\n","\n","  return grid\n"],"metadata":{"id":"cApeIQHSvqAc","executionInfo":{"status":"ok","timestamp":1758993781577,"user_tz":-420,"elapsed":3,"user":{"displayName":"Kira Nguyen","userId":"12077576976160969071"}}},"execution_count":7,"outputs":[]},{"cell_type":"code","source":["#Visualize some instances of training data\n","instances = data['x_train'][:100, :, :, :]\n","grid_img = convert_to_grid(instances)\n","\n","plt.figure(figsize=(15, 15))\n","plt.imshow(grid_img.astype(np.uint8))\n","plt.axis('off')\n","plt.title('Some instances of Training Data')\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"Rf6tGfNkT-nZ","executionInfo":{"status":"ok","timestamp":1758993792437,"user_tz":-420,"elapsed":1421,"user":{"displayName":"Kira Nguyen","userId":"12077576976160969071"}},"outputId":"da0fd7fd-34c0-4687-99b9-45c31b15029e"},"execution_count":8,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1500x1500 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","source":["## 3. Build model of CNN with Keras"],"metadata":{"id":"2gUsh7MMmAdr"}},{"cell_type":"code","source":["#kernels of size 3x3\n","from tensorflow.keras import layers, models\n","\n","model = models.Sequential([\n","    keras.Input(shape=(32, 32, 3)),\n","    layers.Conv2D(64, (3, 3), padding ='same', activation='relu'),\n","    layers.MaxPooling2D((2, 2)),\n","    layers.Flatten(),\n","    layers.Dense(500, activation='relu'),\n","    layers.Dense(43, activation='softmax')\n","])\n","\n","model.compile(optimizer='adam', loss='sparse_categorical_crossentropy', metrics=['accuracy'])"],"metadata":{"id":"7QI0AK--mOJJ","executionInfo":{"status":"ok","timestamp":1758993804651,"user_tz":-420,"elapsed":238,"user":{"displayName":"Kira Nguyen","userId":"12077576976160969071"}}},"execution_count":9,"outputs":[]},{"cell_type":"markdown","source":["## 4. Overfit the kernels with small amount of data"],"metadata":{"id":"lwaApG-48vGa"}},{"cell_type":"code","source":["x_small = data['x_train'][:100]\n","y_small = data['y_train'][:100]\n","\n","from tensorflow.keras.callbacks import LearningRateScheduler\n","def exp_decay(epoch):\n","  initial_lr = 0.01\n","  k = 0.1\n","  lr = initial_lr * np.exp(-k*epoch)\n","  return lr\n","lr_scheduler = LearningRateScheduler(exp_decay)\n","\n","history_small = model.fit(x_small, y_small, epochs=15, batch_size=10,\n","                          validation_data=(data['x_validation'], data['y_validation']),\n","                          callbacks=[lr_scheduler], verbose=1)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"XtEyyuG7YpG7","executionInfo":{"status":"ok","timestamp":1758993951696,"user_tz":-420,"elapsed":140751,"user":{"displayName":"Kira Nguyen","userId":"12077576976160969071"}},"outputId":"f469ff4f-b09f-415a-a8c8-bc1a4672f0f3"},"execution_count":10,"outputs":[{"output_type":"stream","name":"stdout","text":["Epoch 1/15\n","\u001b[1m10/10\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m11s\u001b[0m 1s/step - accuracy: 0.0323 - loss: 10.9969 - val_accuracy: 0.0070 - val_loss: 3.8806 - learning_rate: 0.0100\n","Epoch 2/15\n","\u001b[1m10/10\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m7s\u001b[0m 772ms/step - accuracy: 0.0479 - loss: 3.8136 - val_accuracy: 0.0132 - val_loss: 3.8049 - learning_rate: 0.0090\n","Epoch 3/15\n","\u001b[1m10/10\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m12s\u001b[0m 1s/step - accuracy: 0.0686 - loss: 3.4873 - val_accuracy: 0.0435 - val_loss: 4.1502 - learning_rate: 0.0082\n","Epoch 4/15\n","\u001b[1m10/10\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m11s\u001b[0m 1s/step - accuracy: 0.2849 - loss: 2.8483 - val_accuracy: 0.0601 - val_loss: 5.1506 - learning_rate: 0.0074\n","Epoch 5/15\n","\u001b[1m10/10\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m8s\u001b[0m 868ms/step - accuracy: 0.3641 - loss: 2.4687 - val_accuracy: 0.0821 - val_loss: 6.0260 - learning_rate: 0.0067\n","Epoch 6/15\n","\u001b[1m10/10\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m9s\u001b[0m 757ms/step - accuracy: 0.