","    axs[i].axis('off')\n","    axs[i].set_title(f\"{i+1}\")\n","  plt.tight_layout()\n","  plt.show()"],"metadata":{"id":"jDhOErANAApN","executionInfo":{"status":"ok","timestamp":1758998232625,"user_tz":-420,"elapsed":16,"user":{"displayName":"Kira Nguyen","userId":"12077576976160969071"}}},"execution_count":36,"outputs":[]},{"cell_type":"code","source":["#apply to all models\n","for name, model in models_to_try.items():\n","  print(f\"\\n Visualizing filters for {name}\")\n","  visualize_filters_of_model(model, num_filters=32)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":368},"id":"RQqZKPjTQPlz","executionInfo":{"status":"ok","timestamp":1758998239350,"user_tz":-420,"elapsed":4843,"user":{"displayName":"Kira Nguyen","userId":"12077576976160969071"}},"outputId":"6bb3d5ea-05a9-462f-e75f-2795f396c817"},"execution_count":37,"outputs":[{"output_type":"stream","name":"stdout","text":["\n"," Visualizing filters for CNN_3x3\n","sequential_1: Conv layer filter shape = (3, 3, 3, 32)\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1500x600 with 32 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["\n"," Visualizing filters for CNN_5x5\n","sequential_2: Conv layer filter shape = (5, 5, 3, 32)\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1500x600 with 32 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["\n"," Visualizing filters for CNN_9x9\n","sequential_3: Conv layer filter shape = (9, 9, 3, 32)\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1500x600 with 32 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","source":["## 11. Predict one instance from the test data"],"metadata":{"id":"X1gpvrdNP9aA"}},{"cell_type":"code","source":["#pick an image index\n","idx = 0\n","image = data['x_test'][idx]\n","true_label = data['y_test'][idx]"],"metadata":{"id":"QdhMgMPnQNgT","executionInfo":{"st